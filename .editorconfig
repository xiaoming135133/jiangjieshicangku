# 统一换行与编码：避免 Windows / macOS 混用把 diff 撑爆
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 100

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.gitignore]
insert_final_newline = true
